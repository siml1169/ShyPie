    "local-first",
    "ocr",
    "document-extraction",
    "shypie"
  ],
  "license": "MIT",
  "author": "siml1169",
  "homepage": "https://github.com/siml1169/ShyPie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siml1169/ShyPie.git",
    "directory": "plugins/dsh-privacy-gate"
  },
  "bugs": {
    "url": "https://github.com/siml1169/ShyPie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0 <0.3.0"
