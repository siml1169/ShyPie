{
  "name": "@shypie_privacy/magpie-privacy-gate",
  "version": "0.3.0",
  "type": "module",
  "description": "Magpie gateway middleware: the structural egress gate for the ShyPie privacy-first workflow with DeepSeek Harness. Does not mask text (that stays Magpie's Privacy masking); it turns away image, file and audio parts, encoded blobs and models outside the allowlist when Magpie cannot mask them locally, and fails closed on anything it cannot inspect.",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-middleware",
    "llm-gateway",
    "gateway-middleware",
    "privacy",
    "pii",
    "dlp",
    "guardrails",
    "security",
    "shypie"
  ],
  "license": "MIT",
  "author": "siml1169",
  "homepage": "https://github.com/siml1169/ShyPie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siml1169/ShyPie.git",
    "directory": "plugins/magpie-privacy-gate"
  },
  "bugs": {
    "url": "https://github.com/siml1169/ShyPie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "gate.middleware.js",
    "README.md"
  ],
  "magpie": {
    "middleware": "./gate.middleware.js",
    "name": "ShyPie privacy gate",
    "options": {
      "allowModels": [],
      "localModels": [],
      "localProviders": [],
      "allowUnknownProtocol": false,
      "blobBase64Chars": 400,
      "blobHexChars": 400,
      "scanChars": 200000,
      "maxNodes": 40000,
      "maxDepth": 40,
      "logMaxLines": 40,
      "logEveryRows": 50
    }
  }
}
