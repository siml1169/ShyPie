{
  "name": "@shypie_privacy/magpie-privacy-gate",
  "version": "0.1.0",
  "type": "module",
  "description": "magpie gateway middleware: structural egress firewall. Blocks content parts magpie cannot mask (images, files, documents, audio, video) for models that are not allowlisted as local, blocks encoded blobs smuggled through text, enforces a model allowlist, and fails closed on anything it cannot inspect.",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-middleware",
    "llm-gateway",
    "gateway-middleware",
    "privacy",
    "pii",
    "dlp",
    "guardrails",
    "security",
    "shypie"
  ],
  "license": "MIT",
  "author": "siml1169",
  "homepage": "https://github.com/siml1169/ShyPie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siml1169/ShyPie.git",
    "directory": "plugins/magpie-privacy-gate"
  },
  "bugs": {
    "url": "https://github.com/siml1169/ShyPie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "gate.middleware.js",
    "README.md"
  ],
  "magpie": {
    "middleware": "./gate.middleware.js",
    "name": "ShyPie privacy gate",
    "options": {
      "allowModels": [],
      "localModels": [],
      "allowUnknownProtocol": false,
      "blobBase64Chars": 2048,
      "blobHexChars": 1024,
      "maxTextChars": 1000000,
      "maxNodes": 200000,
      "maxDepth": 40,
      "logMaxLines": 40,
      "logEveryRows": 50
    }
  }
}
