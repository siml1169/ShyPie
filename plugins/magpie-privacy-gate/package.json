{
  "name": "@shypie_privacy/magpie-privacy-gate",
  "version": "0.4.0",
  "type": "module",
  "description": "Magpie gateway middleware: the structural egress gate for the ShyPie privacy-first workflow with DeepSeek Harness, with per-agent controls and a graphical page.",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-middleware",
    "llm-gateway",
    "gateway-middleware",
    "privacy",
    "pii",
    "dlp",
    "guardrails",
    "security",
    "shypie"
  ],
  "license": "MIT",
  "author": "siml1169",
  "homepage": "https://github.com/siml1169/ShyPie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siml1169/ShyPie.git",
    "directory": "plugins/magpie-privacy-gate"
  },
  "bugs": {
    "url": "https://github.com/siml1169/ShyPie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "gate.middleware.js",
    "README.md",
    "page"
  ],
  "magpie": {
    "middleware": "./gate.middleware.js",
    "name": "ShyPie privacy gate",
    "page": {
      "title": "ShyPie Filter",
      "titles": {
        "zh": "ShyPie 防护"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "panels": [
      {
        "slot": "agents",
        "file": "page/agents-panel.html",
        "title": "ShyPie protection",
        "titles": {
          "zh": "ShyPie 防护"
        }
      }
    ],
    "actions": [
      {
        "id": "shypie-protection",
        "menu": "agent",
        "title": "ShyPie protection",
        "titles": {
          "zh": "ShyPie 防护"
        }
      }
    ],
    "permissions": [],
    "options": {
      "allowModels": [],
      "localModels": [],
      "localProviders": [],
      "binaryPolicy": "fail",
      "disabledAgents": [],
      "protectUnknownAgent": true,
      "extraAgents": [],
      "guideTools": [],
      "allowUnknownProtocol": false,
      "blobBase64Chars": 400,
      "blobHexChars": 400,
      "scanChars": 200000,
      "maxNodes": 40000,
      "maxDepth": 40,
      "logMaxLines": 40,
      "logEveryRows": 50
    }
  },
  "scripts": {
    "test": "node test/harness.mjs"
  }
}
